# Server configuration only. Never prefix these values with VITE_.
APP_ORIGIN=http://127.0.0.1:5174
PORT=3001
HOST=127.0.0.1
DATABASE_PATH=./data/brclio.sqlite
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="Brclio Robot <your-sender@gmail.com>"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Cloudflare Worker password/OTP pepper. Generate once and retain across deployments.
# Example generation: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
# Cloudflare Pages runtime variables. Configure these as Plaintext in the dashboard.
GITHUB_APP_ID=5467364
GITHUB_INSTALLATION_ID=
# PKCS#8 PEM; keep the actual private key out of Git.
GITHUB_APP_PRIVATE_KEY=
GITHUB_DATA_OWNER=BrclioData
GITHUB_DATA_REPO=Brclio-Robot-Data
GITHUB_DATA_BRANCH=main
# Enable only behind a single trusted reverse proxy on this machine.
TRUST_PROXY=false
